{
  "manifest_version": 3,
  "name": "网页翻译 · DeepSeek",
  "version": "1.0.1",
  "description": "使用 DeepSeek 将网页翻译为简体中文：根据网页语境（按钮/导航/标题/正文）智能适配文风，支持原文对照、缓存与懒翻译。",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "网页翻译 (DeepSeek)"
  },
  "options_page": "options.html",
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "翻译当前页面为中文"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
